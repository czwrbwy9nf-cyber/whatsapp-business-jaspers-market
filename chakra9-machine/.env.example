# ===========================================
# Chakra9 Content Machine - Environment Config
# ===========================================

# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# n8n Authentication (CHANGE THESE!)
N8N_USER=admin
N8N_PASSWORD=changeme_strong_password_here

# PostgreSQL Database
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_db_password_here

# Timezone
TIMEZONE=America/New_York

# ===========================================
# API Keys (set in n8n Credentials instead!)
# These are fallbacks - prefer using n8n credentials
# ===========================================

# OpenAI (for GPT-4o + Whisper)
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Database References (used in workflows)
# ===========================================

# Airtable
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_BASE_URL=https://airtable.com/appXXXXXXXXXXXXXX

# OR Google Sheets
# GOOGLE_SHEET_ID=1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ===========================================
# Optional Integrations
# ===========================================

# Slack Webhook (for notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Video Factory Worker (if running separately)
# VIDEO_FACTORY_URL=http://video-factory:3000

# ===========================================
# Advanced: Queue Mode Scaling
# ===========================================

# Number of worker replicas (docker-compose scale)
# N8N_WORKER_REPLICAS=2

# Redis connection (auto-configured in docker-compose)
# QUEUE_BULL_REDIS_HOST=redis
# QUEUE_BULL_REDIS_PORT=6379
