        "filterByFormula": "AND({drive_folder_id} = '', {status} = 'active')",
        "options": {}
      },
      "id": "get-pending",
      "name": "Get Yachts Without Drive ID",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [220, 200]
    },
    {
      "parameters": {
        "jsCode": "// Prepare yacht for resolution\nconst yacht = $input.first().json;\n\nreturn [{\n  json: {\n    yacht_id: yacht.yacht_id || yacht.fields?.yacht_id,\n    media_url: yacht.media_url || yacht.fields?.media_url,\n    record_id: yacht.id // Airtable record ID for update\n  }\n}];"
      },
      "id": "prep-yacht",
      "name": "Prepare Yacht Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "HEAD",
        "url": "={{ $json.media_url }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "id": "head-media-url",
      "name": "HEAD Request to Media URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Extract Google Drive folder ID from redirect\nconst response = $input.first().json;\nconst yacht = $('Prepare Yacht Data').first().json;\n\n// Get Location header (redirect URL)\nconst headers = response.headers || {};\nconst location = headers.location || headers.Location || '';\n\nlet result = {\n  yacht_id: yacht.yacht_id,\n  record_id: yacht.record_id,\n  media_url: yacht.media_url,\n  status_code: response.statusCode,\n  redirect_url: location,\n  drive_folder_id: null,\n  drive_folder_url: null,\n  resolved: false,\n  error: null\n};\n\nif (location) {\n  // Extract folder ID from Google Drive URL\n  // Patterns:\n  // https://drive.google.com/drive/folders/FOLDER_ID\n  // https://drive.google.com/drive/u/0/folders/FOLDER_ID\n  const folderMatch = location.match(/folders\\/([a-zA-Z0-9_-]+)/);\n  \n  if (folderMatch) {\n    result.drive_folder_id = folderMatch[1];\n    result.drive_folder_url = location;\n    result.resolved = true;\n  } else {\n    result.error = 'Redirect URL does not contain folder ID';\n  }\n} else if (response.statusCode === 404) {\n  result.error = 'Media URL not found (404)';\n} else {\n  result.error = `No redirect, status: ${response.statusCode}`;\n}\n\nreturn [{ json: result }];"
      },
      "id": "extract-folder-id",
      "name": "Extract Folder ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
