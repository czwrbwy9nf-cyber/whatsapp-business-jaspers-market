      "id": "log-failure",
      "name": "Log Resolution Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 100]
    },
    {
      "parameters": {
        "content": "## Media Resolver (Chakra 3)\n\nResolves media.ycn.miami redirects to Google Drive folder IDs.\n\n### How it works:\n1. HEAD request to media_url (no redirect follow)\n2. Extract Location header\n3. Parse Google Drive folder ID\n4. Update database\n\n### Triggers:\n- Webhook: POST /resolve-media with yacht_id\n- Schedule: Every 6 hours (check pending)",
        "height": 200,
        "width": 320
      },
      "id": "sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-250, -80]
    }
